name: CI Pipeline

on:
  push:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest

    steps:
    - uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.12'

    - name: Install dependencies
      run: pip install pandas scikit-learn xgboost mlflow fastapi uvicorn evidently==0.4.30

    - name: Run training script
      run: python src/train.py

    - name: Check mlruns exists
      run: ls mlruns/